# Banco de dados (o docker-compose sobe um Postgres com estes dados)
DATABASE_URL="postgresql://cardapio:cardapio@localhost:5432/cardapio?schema=public"

# Auth.js — gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Login com Google — https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
