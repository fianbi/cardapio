# Banco de dados (o docker-compose sobe um Postgres com estes dados)
DATABASE_URL="postgresql://cardapio:cardapio@localhost:5433/cardapio?schema=public"

# Auth.js — gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Login com Google — https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Backoffice ──────────────────────────────────────────────────────────────
# E-mails (separados por vírgula) que viram administradores ao abrir /admin pela primeira vez.
ADMIN_EMAILS=""

# ─── Aplicativo (API /api/v1) ────────────────────────────────────────────────
# IDs de cliente OAuth do Google usados pelo app (Android e iOS), separados por vírgula.
# O AUTH_GOOGLE_ID acima também é aceito.
GOOGLE_MOBILE_CLIENT_IDS=""
# Identificador do app no iPhone (bundle id), para o login com Apple. Ex.: br.com.cardapio.app
APPLE_BUNDLE_IDS=""
# Login de teste do app, sem Google/Apple. Só funciona fora de produção. Deixe vazio em produção.
ALLOW_DEV_LOGIN="1"

# ─── Fotos ───────────────────────────────────────────────────────────────────
# Token do Vercel Blob (produção). Sem ele, as fotos são gravadas em apps/web/public/uploads (desenvolvimento).
BLOB_READ_WRITE_TOKEN=""

# ─── Textos legais (termos e privacidade) ───────────────────────────────────
NEXT_PUBLIC_APP_NAME="Cardápio"
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_CONTACT_EMAIL=""
