{
  "name": "cardapio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @cardapio/db migrate",
    "db:seed": "pnpm --filter @cardapio/db seed",
    "db:studio": "pnpm --filter @cardapio/db studio",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
