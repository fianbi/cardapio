# Endereço do servidor (site/API). No celular físico use o IP do computador na rede, ex.: http://192.168.0.10:3001
EXPO_PUBLIC_API_URL="http://localhost:3001"

# Login com Google (https://console.cloud.google.com/apis/credentials)
# ID de cliente do tipo "Aplicativo da Web" (o mesmo AUTH_GOOGLE_ID do servidor)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# ID de cliente do tipo "iOS"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
# O ID do cliente iOS invertido (com.googleusercontent.apps.XXXX), usado na compilação
GOOGLE_IOS_URL_SCHEME=""

# Mostra o "login de teste" (precisa de ALLOW_DEV_LOGIN=1 no servidor). Nunca ligue na versão das lojas.
EXPO_PUBLIC_DEV_LOGIN="1"

# Nome e identificador do app nas lojas
APP_NAME="Cardápio"
APP_ID="br.com.cardapio.app"
EAS_PROJECT_ID=""
